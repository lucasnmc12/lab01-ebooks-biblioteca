@startuml diagrama_de_classes_ebooks

' ---------------------------------------------------------------
' Sistema de Gestao de eBooks da Biblioteca Universitaria
' Lab01S02 - Diagrama de Classes
'
' Responsaveis:
'   Pedro Resende ...... Usuario, Aluno, Estante, Disciplina
'                        (agregacao Aluno / Estante / Ebook)
'   Lucas Nogueira ..... Bibliotecario, Catalogo, Ebook, Licenca,
'                        PeriodoAcesso, CalendarioAcademico,
'                        RegistroDeUso, AdicaoEbook e os enums
'                        (agregacao do acervo)
' ---------------------------------------------------------------

skinparam shadowing false

' ============================ ACESSO ============================

abstract class Usuario {
    -id: String
    -nome: String
    -senha: String
    +autenticarUsuario(senhaDigitada: String): boolean
}

' ======================= ESTANTE DO ALUNO =======================

class Aluno {
    -matricula: String
    -disciplinasEmCurso: List<Disciplina>
    -estantePessoal: Estante
    +adicionarEbookNaEstante(ebook: Ebook): void
    +removerEbookDaEstante(ebook: Ebook): void
    +consultarEstante(): void
}

class Estante {
    -ebooksObrigatorios: List<Ebook>
    -ebooksLivres: List<Ebook>
    +adicionarEbookObrigatorio(ebook: Ebook): void
    +adicionarEbookLivre(ebook: Ebook): void
    +removerEbook(ebook: Ebook): void
    +listarEbooksNaEstante(): List<Ebook>
}

class Disciplina {
    -id: String
    -nome: String
    -ebooksIndicados: List<Ebook>
    +adicionarEbookIndicado(ebook: Ebook): void
    +removerEbookIndicado(ebook: Ebook): void
}

' ======================= GESTAO DO ACERVO =======================

class Bibliotecario {
    -registroFuncional: String
    +cadastrarEbook(titulo: String, editora: String, formato: FormatoArquivo, categoria: Categoria): Ebook
    +definirLicenca(ebook: Ebook, limite: int): void
    +consultarAlunosComEbook(ebook: Ebook): List<Aluno>
    +abrirPeriodoAcesso(inicio: LocalDate, fim: LocalDate): PeriodoAcesso
    +encerrarPeriodoAcesso(periodo: PeriodoAcesso): void
}

class Ebook {
    -id: String
    -titulo: String
    -editora: String
    -formato: FormatoArquivo
    -categoria: Categoria
    -licenca: Licenca
    -statusRenovacao: StatusRenovacao
    +estaDisponivel(): boolean
    +marcarRenovacao(status: StatusRenovacao): void
}

class Licenca {
    -limiteAcessosSimultaneos: int
    -acessosAtivos: int
    +estaDisponivel(): boolean
    +adicionarAcesso(): boolean
    +liberarAcesso(): void
    +definirLimiteAcessos(limite: int): void
}

' O catalogo detem a lista de eBooks do semestre, entao e ele quem
' avalia a renovacao e remove os titulos nao renovados.
class Catalogo {
    -{static} MINIMO_ALUNOS_RENOVACAO: int = 3
    -ebooks: List<Ebook>
    +adicionarEbook(ebook: Ebook): void
    +removerEbook(ebook: Ebook): void
    +listarEbooks(): List<Ebook>
    +avaliarRenovacao(periodo: PeriodoAcesso, registro: RegistroDeUso): void
    +removerNaoRenovados(): void
}

class PeriodoAcesso {
    -inicio: LocalDate
    -fim: LocalDate
    +estaAberto(data: LocalDate): boolean
    +encerrar(): void
}

' Guarda os periodos do semestre e garante que so um fique aberto.
class CalendarioAcademico {
    -periodos: List<PeriodoAcesso>
    +abrirPeriodo(inicio: LocalDate, fim: LocalDate): PeriodoAcesso
    +encerrarPeriodoAberto(): void
    +periodoAberto(): PeriodoAcesso
    +existePeriodoAberto(data: LocalDate): boolean
}

' ===================== REGISTRO E ESTATISTICAS ==================

class AdicaoEbook {
    -data: LocalDate
    -ebook: Ebook
    -aluno: Aluno
    -periodo: PeriodoAcesso
}

' Detem o historico de adicoes, entao e ele quem responde quantos
' alunos distintos ficaram com um titulo e quem notifica as
' estatisticas de uso.
class RegistroDeUso {
    -adicoes: List<AdicaoEbook>
    +registrarAdicao(aluno: Aluno, ebook: Ebook, periodo: PeriodoAcesso): void
    +contarAlunosDistintos(ebook: Ebook, periodo: PeriodoAcesso): int
    +listarAlunosComEbook(ebook: Ebook): List<Aluno>
}

class SistemaEstatisticasUso <<external>> {
    +registrarAdicao(aluno: Aluno, ebook: Ebook): void
}

' ============================= ENUMS ============================

enum FormatoArquivo {
    PDF
    EPUB
}

enum Categoria {
    LITERATURA
    TECNICO
    PERIODICO
}

enum StatusRenovacao {
    PENDENTE
    RENOVAR
    NAO_RENOVAR
}

' ========================= RELACIONAMENTOS ======================

Usuario <|-- Aluno
Usuario <|-- Bibliotecario

Aluno "1" *-- "1" Estante
Estante "0..*" o-- "0..6" Ebook : contém
Aluno "0..*" --> "0..*" Disciplina : cursa
Disciplina "0..*" --> "0..*" Ebook : indica

Catalogo "1" o-- "0..*" Ebook : disponibiliza
Ebook "1" *-- "1" Licenca

Ebook --> FormatoArquivo
Ebook --> Categoria
Ebook --> StatusRenovacao

CalendarioAcademico "1" *-- "0..*" PeriodoAcesso

Bibliotecario "0..*" --> "1" Catalogo : gerencia
Bibliotecario "0..*" --> "1" CalendarioAcademico : administra

RegistroDeUso "1" *-- "0..*" AdicaoEbook
AdicaoEbook "0..*" --> "1" Aluno
AdicaoEbook "0..*" --> "1" Ebook
AdicaoEbook "0..*" --> "1" PeriodoAcesso

Catalogo ..> RegistroDeUso : consulta na renovação
RegistroDeUso ..> SistemaEstatisticasUso : <<notifica>>

@enduml
