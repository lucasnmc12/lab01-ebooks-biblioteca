@startuml diagrama_de_classes_ebooks

' ---------------------------------------------------------------
' Sistema de Gestao de eBooks da Biblioteca Universitaria
' Lab01S02 - Diagrama de Classes
'
' Responsaveis:
'   Pedro Resende ...... Usuario, Aluno, Estante, Disciplina
'                        (agregacao Aluno / Estante / Ebook)
'   Lucas Nogueira ..... Bibliotecario, Catalogo, Ebook, Licenca,
'                        PeriodoAcesso, CalendarioAcademico,
'                        RegistroDeUso, AdicaoEbook e os enums
'                        (agregacao do acervo)
'
' Atualizado na Sprint 3 para refletir o codigo implementado.
' Por convencao, getters e setters nao aparecem no diagrama, assim como
' os metodos restaurar*, usados apenas pela camada de persistencia para
' reconstruir objetos lidos dos arquivos.
' ---------------------------------------------------------------

skinparam shadowing false

' ============================ ACESSO ============================

abstract class Usuario {
    -id: String
    -nome: String
    -senhaHash: String
    +autenticarUsuario(senhaDigitada: String): boolean
    +{static} gerarHash(senha: String): String
}

' ======================= ESTANTE DO ALUNO =======================

class Aluno {
    -matricula: String
    -disciplinasEmCurso: List<Disciplina>
    -estantePessoal: Estante
    +adicionarEbookNaEstante(ebook: Ebook): void
    +removerEbookDaEstante(ebook: Ebook): void
    +consultarEstante(): List<Ebook>
    +ehLeituraObrigatoria(ebook: Ebook): boolean
    +matricularEm(disciplina: Disciplina): void
}

class Estante {
    -ebooksObrigatorios: List<Ebook>
    -ebooksLivres: List<Ebook>
    +adicionarEbookObrigatorio(ebook: Ebook): void
    +adicionarEbookLivre(ebook: Ebook): void
    +removerEbook(ebook: Ebook): void
    +listarEbooksNaEstante(): List<Ebook>
    +contarEbooks(): int
    +contem(ebook: Ebook): boolean
}

class Disciplina {
    -id: String
    -nome: String
    -ebooksIndicados: List<Ebook>
    +adicionarEbookIndicado(ebook: Ebook): void
    +removerEbookIndicado(ebook: Ebook): void
    +indica(ebook: Ebook): boolean
}

' ======================= GESTAO DO ACERVO =======================

class Bibliotecario {
    -registroFuncional: String
    +cadastrarEbook(catalogo: Catalogo, titulo: String, editora: String, formato: FormatoArquivo, categoria: Categoria, limiteAcessos: int): Ebook
    +definirLicenca(ebook: Ebook, limite: int): void
    +consultarAlunosComEbook(registro: RegistroDeUso, ebook: Ebook): List<Aluno>
    +abrirPeriodoAcesso(calendario: CalendarioAcademico, inicio: LocalDate, fim: LocalDate): PeriodoAcesso
    +encerrarPeriodoAcesso(calendario: CalendarioAcademico): void
}

class Ebook {
    -id: String
    -titulo: String
    -editora: String
    -formato: FormatoArquivo
    -categoria: Categoria
    -licenca: Licenca
    -statusRenovacao: StatusRenovacao
    +estaDisponivel(): boolean
    +marcarRenovacao(status: StatusRenovacao): void
    +equals(outro: Object): boolean
}

class Licenca {
    -limiteAcessosSimultaneos: int
    -acessosAtivos: int
    +estaDisponivel(): boolean
    +adicionarAcesso(): boolean
    +liberarAcesso(): void
    +definirLimiteAcessos(limite: int): void
}

' O catalogo detem a lista de eBooks do semestre, entao e ele quem
' avalia a renovacao e remove os titulos nao renovados.
class Catalogo {
    -{static} MINIMO_ALUNOS_RENOVACAO: int = 3
    -ebooks: List<Ebook>
    +adicionarEbook(ebook: Ebook): void
    +removerEbook(ebook: Ebook): void
    +listarEbooks(): List<Ebook>
    +buscarPorId(id: String): Ebook
    +buscarPorTitulo(trecho: String): List<Ebook>
    +proximoId(): String
    +avaliarRenovacao(periodo: PeriodoAcesso, registro: RegistroDeUso): void
    +removerNaoRenovados(): List<Ebook>
}

class PeriodoAcesso {
    -inicio: LocalDate
    -fim: LocalDate
    -encerrado: boolean
    +estaAberto(data: LocalDate): boolean
    +encerrar(): void
    +estaEncerrado(): boolean
}

' Guarda os periodos do semestre e garante que so um fique aberto.
class CalendarioAcademico {
    -periodos: List<PeriodoAcesso>
    +abrirPeriodo(inicio: LocalDate, fim: LocalDate): PeriodoAcesso
    +encerrarPeriodoAberto(): void
    +periodoAberto(): PeriodoAcesso
    +existePeriodoAberto(data: LocalDate): boolean
}

' ===================== REGISTRO E ESTATISTICAS ==================

class AdicaoEbook {
    -data: LocalDate
    -ebook: Ebook
    -aluno: Aluno
    -periodo: PeriodoAcesso
}

' Detem o historico de adicoes, entao e ele quem responde quantos
' alunos distintos ficaram com um titulo e quem notifica as
' estatisticas de uso.
class RegistroDeUso {
    -adicoes: List<AdicaoEbook>
    +registrarAdicao(aluno: Aluno, ebook: Ebook, periodo: PeriodoAcesso): void
    +contarAlunosDistintos(ebook: Ebook, periodo: PeriodoAcesso): int
    +listarAlunosComEbook(ebook: Ebook): List<Aluno>
}

class SistemaEstatisticasUso <<external>> {
    +registrarAdicao(aluno: Aluno, ebook: Ebook): void
}

' ============================= ENUMS ============================

enum FormatoArquivo {
    PDF
    EPUB
}

enum Categoria {
    LITERATURA
    TECNICO
    PERIODICO
}

enum StatusRenovacao {
    PENDENTE
    RENOVAR
    NAO_RENOVAR
}

' ============ INTERFACE E PERSISTENCIA (Sprint 3) ===============
' Estas classes nao guardam regra de negocio: a interface le a entrada
' e exibe o resultado, a persistencia grava e le os arquivos de texto.
' Sao mostradas sem detalhe de metodos, para nao competir com o dominio.

package "interface" <<Rectangle>> {
    class MenuPrincipal
    class MenuAluno
    class MenuBibliotecario
    class Console
    class Biblioteca
    class DadosIniciais
}

package "persistencia" <<Rectangle>> {
    class ArquivoDados
    class EbookRepositorioArquivo
    class UsuarioRepositorioArquivo
    class EstanteRepositorioArquivo
    class PeriodoAcessoRepositorioArquivo
    class RegistroDeUsoRepositorioArquivo
    class DisciplinaRepositorioArquivo
}

' ========================= RELACIONAMENTOS ======================

Usuario <|-- Aluno
Usuario <|-- Bibliotecario

Aluno "1" *-- "1" Estante
Estante "0..*" o-- "0..6" Ebook : contém
Aluno "0..*" --> "0..*" Disciplina : cursa
Disciplina "0..*" --> "0..*" Ebook : indica

Catalogo "1" o-- "0..*" Ebook : disponibiliza
Ebook "1" *-- "1" Licenca

Ebook --> FormatoArquivo
Ebook --> Categoria
Ebook --> StatusRenovacao

CalendarioAcademico "1" *-- "0..*" PeriodoAcesso

Bibliotecario "0..*" --> "1" Catalogo : gerencia
Bibliotecario "0..*" --> "1" CalendarioAcademico : administra

RegistroDeUso "1" *-- "0..*" AdicaoEbook
AdicaoEbook "0..*" --> "1" Aluno
AdicaoEbook "0..*" --> "1" Ebook
AdicaoEbook "0..*" --> "1" PeriodoAcesso

Catalogo ..> RegistroDeUso : consulta na renovação
RegistroDeUso ..> SistemaEstatisticasUso : <<notifica>>

MenuPrincipal --> Biblioteca
MenuPrincipal ..> MenuAluno
MenuPrincipal ..> MenuBibliotecario
MenuPrincipal ..> DadosIniciais
MenuAluno --> Console
MenuBibliotecario --> Console
MenuAluno ..> Aluno
MenuBibliotecario ..> Bibliotecario

Biblioteca --> Catalogo
Biblioteca --> CalendarioAcademico
Biblioteca --> RegistroDeUso
Biblioteca ..> EbookRepositorioArquivo
Biblioteca ..> UsuarioRepositorioArquivo
Biblioteca ..> EstanteRepositorioArquivo
Biblioteca ..> PeriodoAcessoRepositorioArquivo
Biblioteca ..> RegistroDeUsoRepositorioArquivo
Biblioteca ..> DisciplinaRepositorioArquivo

EbookRepositorioArquivo ..> ArquivoDados
UsuarioRepositorioArquivo ..> ArquivoDados
EstanteRepositorioArquivo ..> ArquivoDados
PeriodoAcessoRepositorioArquivo ..> ArquivoDados
RegistroDeUsoRepositorioArquivo ..> ArquivoDados
DisciplinaRepositorioArquivo ..> ArquivoDados

@enduml
