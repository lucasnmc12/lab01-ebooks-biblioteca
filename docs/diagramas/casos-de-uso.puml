@startuml casos_de_uso_ebooks

' ---------------------------------------------------------------
' Sistema de Gestao de eBooks da Biblioteca Universitaria
' Lab01S01 - Diagrama de Casos de Uso
'
' Responsaveis:
'   Lucas Nogueira ..... UC07, UC08, UC09, UC10, UC11, UC12 (Bibliotecario)
'   Pedro Resende ...... UC01, UC02, UC03, UC04, UC05, UC06 (Aluno / acesso)
' ---------------------------------------------------------------

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 20
skinparam ranksep 80
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "Aluno" as Aluno
actor "Bibliotecário" as Bibliotecario

rectangle "Sistema de Gestão de eBooks" {

  package "Acesso" {
    usecase "Realizar login" as UC01
  }

  package "Estante do aluno" {
    usecase "Adicionar eBook à estante" as UC02
    usecase "Remover eBook da estante" as UC03
    usecase "Consultar estante pessoal" as UC04
    usecase "Verificar disponibilidade de licença" as UC05
  }

  package "Gestão do acervo" {
    usecase "Cadastrar eBook" as UC07
    usecase "Definir licença de uso" as UC08
    usecase "Consultar alunos com um eBook" as UC09
    usecase "Avaliar renovação do catálogo" as UC11
    usecase "Remover eBook do catálogo" as UC12
  }
}

Aluno --> UC01
Bibliotecario --> UC01

Aluno --> UC02
Aluno --> UC03
Aluno --> UC04

Bibliotecario --> UC07
Bibliotecario --> UC09
Bibliotecario --> UC11

' Login e incluido por todos os casos de uso que exigem usuario autenticado.
' A seta esta escrita como "UC01 <.. UCxx" apenas para o PlantUML posicionar
' o login proximo aos atores; a dependencia continua saindo de UCxx para UC01.
UC01 <.. UC02 : <<include>>
UC01 <.. UC03 : <<include>>
UC01 <.. UC04 : <<include>>
UC01 <.. UC07 : <<include>>
UC01 <.. UC09 : <<include>>
UC01 <.. UC11 : <<include>>

UC02 ..> UC05 : <<include>>
UC07 ..> UC08 : <<include>>

' Extend: a remocao do catalogo so acontece quando o eBook nao alcanca
' o minimo de 3 alunos ao final do periodo de acesso.
UC12 ..> UC11 : <<extend>>

@enduml
